# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================

# NODE ENVIRONMENT
NODE_ENV=development
PORT=5000

# ============================================
# DATABASE
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=whix_vtu
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_password
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/whix_vtu

# ============================================
# REDIS CACHE
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# ============================================
# PAYMENT GATEWAYS
# ============================================

# Paystack
PAYSTACK_SECRET_KEY=pk_test_your_paystack_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public
PAYSTACK_WEBHOOK_SECRET=whsec_your_webhook_secret

# Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-flutterwave-key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-flutterwave-public
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook

# ============================================
# VTU PROVIDER APIs
# ============================================

# Airtime & Data Provider (e.g., Baxi, DartAPI, etc.)
VTU_PROVIDER_API_KEY=your_vtu_provider_key
VTU_PROVIDER_BASE_URL=https://api.vtu-provider.com

# ============================================
# EXTERNAL SERVICES
# ============================================

# SendGrid (Email)
SENDGRID_API_KEY=SG.your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@whixvtu.com

# Twilio (SMS & 2FA)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=whix-vtu-firebase
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=firebase-admin@whix-vtu.iam.gserviceaccount.com

# OpenAI (Chatbot)
OPENAI_API_KEY=sk_test_your_openai_key

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=whix-vtu-uploads

# ============================================
# FRONTEND CONFIGURATION
# ============================================

REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_PAYSTACK_KEY=pk_test_your_paystack_public
REACT_APP_FLUTTERWAVE_KEY=FLWPUBK_TEST-your-flutterwave-public

# ============================================
# SECURITY
# ============================================

BCRYPT_ROUNDS=10
SESSION_SECRET=your_session_secret_key
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING & MONITORING
# ============================================

LOG_LEVEL=debug
SENTRY_DSN=https://your_sentry_dsn
MORGAN_FORMAT=combined

# ============================================
# FRAUD DETECTION
# ============================================

FRAUD_DETECTION_ENABLED=true
FRAUD_THRESHOLD=0.7

# ============================================
# ADMIN SETTINGS
# ============================================

ADMIN_EMAIL=admin@whixvtu.com
ADMIN_PASSWORD=Change_This_In_Production
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15
