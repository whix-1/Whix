{
  "name": "whix-vtu-backend",
  "version": "1.0.0",
  "description": "Whix VTU Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "npx sequelize-cli db:migrate",
    "seed": "npx sequelize-cli db:seed:all",
    "test": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.0",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "pg": "^8.11.3",
    "sequelize": "^6.35.2",
    "redis": "^4.6.12",
    "ioredis": "^5.3.2",
    "bull": "^4.11.5",
    "axios": "^1.6.2",
    "paystack": "^1.0.2",
    "flutterwave-sdk": "^1.0.0",
    "firebase-admin": "^12.0.0",
    "openai": "^4.24.0",
    "aws-sdk": "^2.1551.0",
    "sharp": "^0.33.1",
    "nodemailer": "^6.9.7",
    "twilio": "^4.8.0",
    "qrcode": "^1.5.3",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "sentry-node": "^7.80.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/jest": "^29.5.11",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2"
  }
}
